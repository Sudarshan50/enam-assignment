# Postgres. Local: docker compose. Production: Supabase session pooler (port 5432, IPv4).
DATABASE_URL=postgres://finn:finn@localhost:54329/finn

# LLM (OpenAI-compatible endpoint)
LLM_BASE_URL=https://inference.hyde.tech/v1
LLM_API_KEY=
LLM_MODEL=hyde/glm-5.3-flash
LLM_DAILY_CALL_BUDGET=2000

# Embeddings (Cloudflare Workers AI)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
EMBEDDING_MODEL=@cf/google/embeddinggemma-2
EMBEDDING_DIMS=768

# API
PORT=4000
JOBS_SECRET=change-me
CORS_ORIGIN=http://localhost:3000
RESEARCH_RUNS_PER_DAY=40

# Worker trigger (fine-grained token: Actions write + Metadata read)
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=Sudarshan50/enam-assignment
GITHUB_RESEARCH_WORKFLOW=research.yml

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:oraonsudarshan@gmail.com

# Optional people search for management-change cards
EXA_API_KEY=
